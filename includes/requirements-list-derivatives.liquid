{% comment %}
  Requirements derived from this Requirements resource. Parameters: requirement, lang.
{% endcomment %}
{% assign whoStrings = site.data.stringsWHO[include.lang] | default: site.data.stringsWHO.en %}
{% assign xvDerivedFrom = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.derivedFrom" %}
{% assign xvTitle = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.title" %}
{% assign canonicals = site.data.canonicals | where: 'type' , 'Requirements' %}
{{whoStrings.RequirementDerivatives}}
<ul>
  {% for canonical in canonicals %}
    {% assign stub = canonical.type | append: "-" | append: canonical.id %}
    {% assign req = site.data[stub] %}
    {% assign dfs = req.derivedFrom %}
    {% unless dfs %}{% assign dfs = req.extension | where: 'url', xvDerivedFrom | map: 'valueCanonical' %}{% endunless %}
    {% for df in dfs %}
      {% assign dfinstance = df | split: "|" | first | split: "/" | last %}
      {% if dfinstance == include.requirement.id %}
        {% assign reqtitle = req.title %}
        {% unless reqtitle %}{% assign reqtitle = req.extension | where: "url", xvTitle | map: "valueString" | first %}{% endunless %}
        <li><a href="Requirements-{{ req.id }}.html">{{ reqtitle | escape }}</a></li>
      {% endif %}
    {% endfor %}
  {% endfor %}
</ul>
