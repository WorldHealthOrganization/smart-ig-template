{% comment %}
  Summary table of an ActorDefinition.
  Parameters: actordefinition (the resource from site.data), lang.
  Reads the R5 elements, or the R5 cross-version extensions when the resource carries those instead.
{% endcomment %}
{% assign whoStrings = site.data.stringsWHO[include.lang] | default: site.data.stringsWHO.en %}
{% assign xvPublisher = "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.publisher" %}
{% assign xvContact = "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.contact" %}
{% assign xvJurisdiction = "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.jurisdiction" %}
{% assign xvCapabilities = "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.capabilities" %}
{% assign ext = include.actordefinition.extension %}

{% assign publisher = include.actordefinition.publisher %}
{% unless publisher %}{% assign publisher = ext | where: "url", xvPublisher | map: "valueString" | first %}{% endunless %}
{% assign contacts = include.actordefinition.contact %}
{% unless contacts %}{% assign contacts = ext | where: "url", xvContact | map: "valueContactDetail" %}{% endunless %}
{% assign telecoms = contacts | map: "telecom" | first %}
{% assign contacturl = telecoms | where: "system", "url" | map: "value" | first %}
{% assign contactemail = telecoms | where: "system", "email" | map: "value" | first %}
{% assign jurisdiction = include.actordefinition.jurisdiction | first %}
{% unless jurisdiction %}{% assign jurisdiction = ext | where: "url", xvJurisdiction | map: "valueCodeableConcept" | first %}{% endunless %}
{% assign capes = include.actordefinition.capabilities %}
{% unless capes %}{% assign capes = ext | where: "url", xvCapabilities | map: "valueCanonical" %}{% endunless %}
{% assign capes = capes | join: " " | split: " " %}

<table border="1" style="border-collapse: collapse;">
  <tbody>
    <tr>
      <th>{{whoStrings.Publisher}}</th>
      <td>
{% if publisher == empty or publisher == nil %}
  {% if contacturl == empty or contacturl == nil %}
        {{whoStrings.NoPublisher}}
  {% else %}
        {{ contacturl }}
  {% endif %}
{% else %}
  {% if contacturl == empty or contacturl == nil %}
        {{ publisher }}
  {% else %}
        <a href="{{ contacturl }}">{{ publisher }}</a>
  {% endif %}
{% endif %}
      </td>
    </tr>
    <tr>
      <th>{{whoStrings.ContactEmail}}</th>
      <td>
{% if contactemail == empty or contactemail == nil %}
        {{whoStrings.NoContactEmail}}
{% else %}
        {{ contactemail }}
{% endif %}
      </td>
    </tr>
    <tr>
      <th>{{whoStrings.Jurisdiction}}</th>
      <td>{{ jurisdiction.coding | first | map: "code" | first }}</td>
    </tr>
{% unless capes == empty or capes == nil %}
    <tr>
      <th>{{whoStrings.CapabilityStatements}}</th>
      <td>{% include actordefinition-list-capabilites.liquid site=site actordefinition=include.actordefinition lang=include.lang %}</td>
    </tr>
{% endunless %}
    <tr>
      <th>{{whoStrings.Requirements}}</th>
      <td>{% include actordefinition-list-requirements-full.liquid site=site actordefinition=include.actordefinition lang=include.lang %}</td>
    </tr>
  </tbody>
</table>
