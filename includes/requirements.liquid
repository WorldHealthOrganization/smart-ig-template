{% comment %}
  Summary table of a Requirements resource.
  Parameters: requirement (the resource from site.data), lang.
  Reads the R5 elements, or the R5 cross-version extensions when the resource carries those instead.
{% endcomment %}
{% assign whoStrings = site.data.stringsWHO[include.lang] | default: site.data.stringsWHO.en %}
{% assign xvPublisher = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.publisher" %}
{% assign xvContact = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.contact" %}
{% assign xvJurisdiction = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.jurisdiction" %}
{% assign xvDerivedFrom = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.derivedFrom" %}
{% assign xvActor = "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.actor" %}
{% assign ext = include.requirement.extension %}

{% assign publisher = include.requirement.publisher %}
{% unless publisher %}{% assign publisher = ext | where: "url", xvPublisher | map: "valueString" | first %}{% endunless %}
{% assign contacts = include.requirement.contact %}
{% unless contacts %}{% assign contacts = ext | where: "url", xvContact | map: "valueContactDetail" %}{% endunless %}
{% assign telecoms = contacts | map: "telecom" | first %}
{% assign contacturl = telecoms | where: "system", "url" | map: "value" | first %}
{% assign contactemail = telecoms | where: "system", "email" | map: "value" | first %}
{% assign jurisdiction = include.requirement.jurisdiction | first %}
{% unless jurisdiction %}{% assign jurisdiction = ext | where: "url", xvJurisdiction | map: "valueCodeableConcept" | first %}{% endunless %}
{% assign parents = include.requirement.derivedFrom %}
{% unless parents %}{% assign parents = ext | where: "url", xvDerivedFrom | map: "valueCanonical" %}{% endunless %}
{% assign actors = include.requirement.actor %}
{% unless actors %}{% assign actors = ext | where: "url", xvActor | map: "valueCanonical" %}{% endunless %}

<table border="1" style="border-collapse: collapse;">
  <tbody>
    <tr>
      <th>{{whoStrings.Publisher}}</th>
      <td>
{% if publisher == empty or publisher == nil %}
  {% if contacturl == empty or contacturl == nil %}
        {{whoStrings.NoPublisher}}
  {% else %}
        {{ contacturl }}
  {% endif %}
{% else %}
  {% if contacturl == empty or contacturl == nil %}
        {{ publisher }}
  {% else %}
        <a href="{{ contacturl }}">{{ publisher }}</a>
  {% endif %}
{% endif %}
      </td>
    </tr>
    <tr>
      <th>{{whoStrings.ContactEmail}}</th>
      <td>
{% if contactemail == empty or contactemail == nil %}
        {{whoStrings.NoContactEmail}}
{% else %}
        {{ contactemail }}
{% endif %}
      </td>
    </tr>
    <tr>
      <th>{{whoStrings.Jurisdiction}}</th>
      <td>{{ jurisdiction.coding | first | map: "code" | first }}</td>
    </tr>
    <tr>
      <th>{{whoStrings.Statements}}</th>
      <td>{% include requirements-list-statements.liquid site=site requirement=include.requirement lang=include.lang %}</td>
    </tr>
    <tr>
      <th>{{whoStrings.DerivedFrom}}</th>
      <td>
{% if parents == empty or parents == nil %}
        {{whoStrings.NotDerived}}
{% else %}
        <ul>
  {% for parent in parents %}
    {% assign parentinstance = parent | split: "|" | first | split: "/" | last | split: ".html" | first %}
    {% assign parentpage = "Requirements-" | append: parentinstance | append: ".html" %}
    {% assign parentname = site.data.pages[parentpage].titlelang[include.lang] | default: site.data.pages[parentpage].title %}
          <li><a href="{{ parentpage }}">{{ parentname | escape }}</a></li>
  {% endfor %}
        </ul>
{% endif %}
      </td>
    </tr>
    <tr>
      <th>{{whoStrings.Derivatives}}</th>
      <td>{% include requirements-list-derivatives.liquid site=site requirement=include.requirement lang=include.lang %}</td>
    </tr>
    <tr>
      <th>{{whoStrings.ParticipatingActors}}</th>
      <td>
        <ul>
{% for actor in actors %}
  {% assign actorinstance = actor | split: "|" | first | split: "/" | last | split: ".html" | first %}
  {% assign actorpage = "ActorDefinition-" | append: actorinstance | append: ".html" %}
  {% assign actorname = site.data.pages[actorpage].titlelang[include.lang] | default: site.data.pages[actorpage].title %}
          <li><a href="{{ actorpage }}">{{ actorname | escape }}</a></li>
{% endfor %}
        </ul>
      </td>
    </tr>
  </tbody>
</table>
